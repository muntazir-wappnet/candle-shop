generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  API
  UNKNOWN
}

model User {
  id           String       @id @default(cuid())

  name         String?

  email        String?      @unique
  phone_number String?      @unique

  password     String?

  provider     AuthProvider @default(PASSWORD)

  googleId     String?      @unique

  isVerified   Boolean      @default(false)

  role         UserRole     @default(CUSTOMER)

  orders        Order[]
  refreshTokens RefreshToken[]

  sellerApplicationsAsApplicant SellerApplication[] @relation("SellerApplicationApplicant")
  sellerApplicationsAsReviewer  SellerApplication[] @relation("SellerApplicationReviewer")
  seller                        Seller?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10,2)
  stock       Int

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  userId      String

  user        User        @relation(fields: [userId], references: [id])

  totalAmount Decimal     @db.Decimal(10,2)

  status      OrderStatus @default(PENDING)

  items       OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())

  orderId   String
  productId String

  quantity  Int
  price     Decimal @db.Decimal(10,2)

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// ── Asset Module ──────────────────────────────────────────────────────────────

enum AssetStatus {
  TEMPORARY        // Uploaded but not yet attached to any entity
  ACTIVE           // Currently in use by at least one entity
  PENDING_DELETION // No longer referenced — queued for Cloudinary cleanup
  DELETED          // Cleanup completed (historical record)
}

enum AssetProvider {
  CLOUDINARY
}

enum AssetOwnerType {
  CATEGORY
  PRODUCT
  PRODUCT_VARIANT
  SELLER_APPLICATION
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SellerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssetRole {
  COVER   // Primary/hero image for an entity
  GALLERY // One of many gallery images
}

model Asset {
  id             String        @id @default(cuid())
  provider       AssetProvider @default(CLOUDINARY)

  // ── Cloudinary metadata ────────────────────────────────────────────────────
  publicId       String        @unique
  url            String
  optimizedUrl   String
  thumbnailUrl   String
  placeholderUrl String

  // ── Dimensions & file info ─────────────────────────────────────────────────
  width          Int           @default(0)
  height         Int           @default(0)
  format         String
  mimeType       String
  size           Int           // in bytes

  // ── Lifecycle ─────────────────────────────────────────────────────────────
  status         AssetStatus   @default(TEMPORARY)

  references         AssetReference[]
  sellerApplications SellerApplication[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([publicId])
  @@index([status])
}

model AssetReference {
  id        String         @id @default(cuid())

  assetId   String
  asset     Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // ── Owner ──────────────────────────────────────────────────────────────────
  ownerType AssetOwnerType
  ownerId   String

  // ── Usage context ──────────────────────────────────────────────────────────
  role      AssetRole      @default(COVER)
  sortOrder Int            @default(0)
  isPrimary Boolean        @default(false)

  createdAt DateTime       @default(now())

  @@index([ownerType, ownerId])
}

model RefreshToken {
  id         String     @id @default(cuid())

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  // ── Device Info ─────────────────────────────────
  userAgent  String?
  ipAddress  String?
  deviceName String?
  deviceType DeviceType @default(UNKNOWN)

  createdAt  DateTime   @default(now())

  @@index([userId])
}

// ── Seller Onboarding ─────────────────────────────────────────────────────────

model SellerApplication {
  id                          String                  @id @default(cuid())
  userId                      String
  storeName                   String
  description                 String
  gstNumber                   String?
  instagramUrl                String?
  websiteUrl                  String?
  verificationDocumentAssetId String
  status                      SellerApplicationStatus @default(PENDING)
  reviewerId                  String?
  reviewedAt                  DateTime?
  rejectionReason             String?

  applicant                 User  @relation("SellerApplicationApplicant", fields: [userId], references: [id])
  reviewer                  User? @relation("SellerApplicationReviewer", fields: [reviewerId], references: [id])
  verificationDocumentAsset Asset @relation(fields: [verificationDocumentAssetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Seller {
  id          String       @id @default(cuid())
  userId      String       @unique
  storeName   String
  description String
  slug        String       @unique
  status      SellerStatus @default(ACTIVE)
  approvedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}