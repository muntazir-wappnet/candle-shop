generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  API
  UNKNOWN
}

model User {
  id           String       @id @default(cuid())

  name         String?

  email        String?      @unique
  phone_number String?      @unique

  password     String?

  provider     AuthProvider @default(PASSWORD)

  googleId     String?      @unique

  isVerified   Boolean      @default(false)

  role         UserRole     @default(CUSTOMER)

  orders       Order[]
  refreshTokens RefreshToken[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10,2)
  stock       Int

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  userId      String

  user        User        @relation(fields: [userId], references: [id])

  totalAmount Decimal     @db.Decimal(10,2)

  status      OrderStatus @default(PENDING)

  items       OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())

  orderId   String
  productId String

  quantity  Int
  price     Decimal @db.Decimal(10,2)

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model RefreshToken {
  id         String     @id @default(cuid())

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  // ── Device Info ─────────────────────────────────
  userAgent  String?
  ipAddress  String?
  deviceName String?
  deviceType DeviceType @default(UNKNOWN)

  createdAt  DateTime   @default(now())

  @@index([userId])
}